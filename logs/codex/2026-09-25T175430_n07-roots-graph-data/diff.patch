+    const { graphData } = buildRootQualifiedGraphData(
+      [note],
+      [makeConnection(note.uri, placeholder)],
+      [vaultRoot]
+    );
+    expect(graphData.nodeInfo['missing.md']).toBeUndefined();
+    expect(graphData.links).toEqual([]);
+  });
+});
