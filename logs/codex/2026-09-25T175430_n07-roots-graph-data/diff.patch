+function makeResource(uri: URI, title = uri.getBasename()): Resource {
+  return {
+    uri,
+    type: 'note',
+    title,
+    properties: {},
+    sections: [],
+    blocks: [],
+    tags: [],
+    aliases: [],
+    links: [],
+    footnotes: [],
+  };
+}
+
+function makeConnection(source: URI, target: URI): Connection {
+  return {
+    source,
+    target,
+    link: {
+      type: 'wikilink',
+      rawText: '[[target]]',
+      range: Range.create(0, 0, 0, 0),
+      isEmbed: false,
+    },
+  };
+}
