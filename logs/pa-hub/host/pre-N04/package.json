      },
      {
        "command": "pa-hub.create-note-from-template",
        "title": "Foam: Create New Note From Template",
        "category": "PA Hub"
      },
      {
        "command": "pa-hub.create-note-from-default-template",
        "title": "Foam: Create New Note",
