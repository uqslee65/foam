{
  "name": "pa-hub",
  "displayName": "PA Hub",
  "description": "PA Hub: Lazarus personal-assistant sidebar (Foam fork) with wikilinks, graph and board",
  "private": true,
  "repository": {
    "url": "https://github.com/foambubble/foam",
    "type": "git"
  },
  "homepage": "https://github.com/foambubble/foam",
  "version": "0.44.6",
  "license": "MIT",
  "publisher": "lazarus",
  "engines": {
    "vscode": "^1.110.0"
  },
  "icon": "assets/icon/FOAM_ICON_256.png",
  "categories": [
    "Other"
  ],
  "main": "./out/bundles/extension-node.js",
  "browser": "./out/bundles/extension-web.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "JavaScript queries and templates are disabled, and new notes must be created inside the workspace."
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./static/preview/style.css"
    ],
    "markdown.previewScripts": [
      "./static/preview/block-anchor-scroll.js"
    ],
    "grammars": [
      {
        "path": "./syntaxes/injection.json",
        "scopeName": "pa-hub.wikilink.injection",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "colors": [
      {
        "id": "pa-hub.placeholder",
        "description": "Color of foam placeholders.",
        "defaults": {
          "dark": "editorWarning.foreground",
          "light": "editorWarning.foreground",
          "highContrast": "editorWarning.foreground"
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "pa-hub.connections",
          "name": "Connections",
          "icon": "$(references)",
          "contextualTitle": "Foam"
        },
        {
          "id": "pa-hub.tags-explorer",
          "name": "Tag Explorer",
          "icon": "$(tag)",
          "contextualTitle": "Foam"
        },
        {
          "id": "pa-hub.notes-explorer",
          "name": "Notes",
          "icon": "$(notebook)",
          "contextualTitle": "Foam"
        },
        {
          "id": "pa-hub.orphans",
          "name": "Orphans",
          "icon": "$(debug-gripper)",
          "contextualTitle": "Foam"
        },
        {
          "id": "pa-hub.placeholders",
          "name": "Placeholders",
          "icon": "$(debug-disconnect)",
          "contextualTitle": "Foam"
        },
        {
          "id": "pa-hub.smart-folders",
          "name": "Smart Folders",
          "icon": "$(folder-library)",
          "contextualTitle": "Foam",
          "initialSize": 0
        },
        {
          "when": "config.pa-hub.experimental",
          "id": "pa-hub.related-notes",
          "name": "Related Notes (AI)",
          "icon": "$(sparkle)",
          "contextualTitle": "Foam"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pa-hub.tags-explorer",
        "contents": "No tags found. Notes that contain tags will show up here. You may add tags to a note with a hashtag (#tag) or by adding a tag list to the front matter (tags: tag1, tag2)."
      },
      {
        "view": "pa-hub.connections",
        "contents": "Nothing found for the selected resource and the current filter."
      },
      {
        "view": "pa-hub.orphans",
        "contents": "No orphans found. Notes that have no backlinks nor links will show up here."
      },
      {
        "view": "pa-hub.placeholders",
        "contents": "No placeholders found for selected resource or workspace."
      },
      {
        "view": "pa-hub.smart-folders",
        "contents": "Smart Folders are saved queries stored in `.foam/queries/`. They group your notes by tag, link, or any other criteria you can express in a query.\n[Create Smart Folder](command:pa-hub.views.smart-folders.create)\nLearn more about [Smart Folders](https://docs.foam.md/features/smart-folders) and [Foam Queries](https://docs.foam.md/features/foam-queries)."
      },
      {
        "view": "pa-hub.related-notes",
        "contents": "Open a note to see related notes.",
        "when": "config.pa-hub.experimental && pa-hub.relatedNotes.state == 'no-note'"
      },
      {
        "view": "pa-hub.related-notes",
        "contents": "Notes haven't been analyzed yet.\n[Analyze Notes](command:pa-hub.build-embeddings)\nAnalyze your notes to discover similar content.",
        "when": "config.pa-hub.experimental && pa-hub.relatedNotes.state == 'no-embedding'"
      },
      {
        "view": "pa-hub.related-notes",
        "contents": "No similar notes found for the current note.",
        "when": "config.pa-hub.experimental && pa-hub.relatedNotes.state == 'ready'"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "pa-hub.search-tag",
          "when": "view == pa-hub.tags-explorer && viewItem == tag",
          "group": "inline",
          "icon": "$(search)"
        },
        {
          "command": "pa-hub.rename-tag",
          "when": "view == pa-hub.tags-explorer && viewItem == tag",
          "group": "inline",
          "icon": "$(edit)"
        },
        {
          "command": "pa-hub.views.smart-folders.edit",
          "when": "view == pa-hub.smart-folders && (viewItem == smart-folder || viewItem == smart-folder-error)",
          "group": "inline@1",
          "icon": "$(edit)"
        },
        {
          "command": "pa-hub.views.smart-folders.delete",
          "when": "view == pa-hub.smart-folders && (viewItem == smart-folder || viewItem == smart-folder-error)",
          "group": "inline@2",
          "icon": "$(trash)"
        }
      ],
      "editor/context": [
        {
          "command": "pa-hub.rename-tag",
          "when": "editorTextFocus && resourceExtname == '.md'",
          "group": "foam",
          "title": "Rename Tag"
        }
      ],
      "view/title": [
        {
          "command": "pa-hub.views.connections.show:backlinks",
          "when": "view == pa-hub.connections && pa-hub.views.connections.show == 'all links'",
          "group": "navigation@1"
        },
        {
          "command": "pa-hub.views.connections.show:forward-links",
          "when": "view == pa-hub.connections && pa-hub.views.connections.show == 'backlinks'",
          "group": "navigation@1"
        },
        {
          "command": "pa-hub.views.connections.show:all-links",
          "when": "view == pa-hub.connections && pa-hub.views.connections.show == 'forward links'",
          "group": "navigation@1"
        },
        {
          "command": "pa-hub.views.connections.include:notes-only",
          "when": "view == pa-hub.connections && pa-hub.views.connections.include == 'all'",
          "group": "navigation@2"
        },
        {
          "command": "pa-hub.views.connections.include:all",
          "when": "view == pa-hub.connections && pa-hub.views.connections.include == 'notes-only'",
          "group": "navigation@2"
        },
        {
          "command": "pa-hub.views.orphans.group-by:folder",
          "when": "view == pa-hub.orphans && pa-hub.views.orphans.group-by == 'off'",
          "group": "navigation@1"
        },
        {
          "command": "pa-hub.views.orphans.group-by:off",
          "when": "view == pa-hub.orphans && pa-hub.views.orphans.group-by == 'folder'",
          "group": "navigation@1"
        },
        {
          "command": "pa-hub.views.tags-explorer.show:for-current-file",
          "when": "view == pa-hub.tags-explorer && pa-hub.views.tags-explorer.show == 'all'",
          "group": "navigation@1"
        },
        {
          "command": "pa-hub.views.tags-explorer.show:all",
          "when": "view == pa-hub.tags-explorer && pa-hub.views.tags-explorer.show == 'for-current-file'",
          "group": "navigation@1"
        },
        {
          "command": "pa-hub.views.tags-explorer.group-by:folder",
          "when": "view == pa-hub.tags-explorer && pa-hub.views.tags-explorer.group-by == 'off'",
          "group": "navigation@2"
        },
        {
          "command": "pa-hub.views.tags-explorer.group-by:off",
          "when": "view == pa-hub.tags-explorer && pa-hub.views.tags-explorer.group-by == 'folder'",
          "group": "navigation@2"
        },
        {
          "command": "pa-hub.views.tags-explorer.expand-all",
          "when": "view == pa-hub.tags-explorer",
          "group": "navigation@3"
        },
        {
          "command": "pa-hub.views.placeholders.show:for-current-file",
          "when": "view == pa-hub.placeholders && pa-hub.views.placeholders.show == 'all'",
          "group": "navigation@1"
        },
        {
          "command": "pa-hub.views.placeholders.show:all",
          "when": "view == pa-hub.placeholders && pa-hub.views.placeholders.show == 'for-current-file'",
          "group": "navigation@1"
        },
        {
          "command": "pa-hub.views.placeholders.group-by:folder",
          "when": "view == pa-hub.placeholders && pa-hub.views.placeholders.group-by == 'off'",
          "group": "navigation@2"
        },
        {
          "command": "pa-hub.views.placeholders.group-by:off",
          "when": "view == pa-hub.placeholders && pa-hub.views.placeholders.group-by == 'folder'",
          "group": "navigation@2"
        },
        {
          "command": "pa-hub.views.placeholders.expand-all",
          "when": "view == pa-hub.placeholders",
          "group": "navigation@3"
        },
        {
          "command": "pa-hub.views.notes-explorer.connections:toggle",
          "when": "view == pa-hub.notes-explorer",
          "group": "navigation@1"
        },
        {
          "command": "pa-hub.views.notes-explorer.include:notes-only",
          "when": "view == pa-hub.notes-explorer && pa-hub.views.notes-explorer.include == 'all'",
          "group": "navigation@2"
        },
        {
          "command": "pa-hub.views.notes-explorer.include:all",
          "when": "view == pa-hub.notes-explorer && pa-hub.views.notes-explorer.include == 'notes-only'",
          "group": "navigation@2"
        },
        {
          "command": "pa-hub.views.notes-explorer.view:toggle",
          "when": "view == pa-hub.notes-explorer",
          "group": "navigation@3"
        },
        {
          "command": "pa-hub.views.notes-explorer.set-filter",
          "when": "view == pa-hub.notes-explorer",
          "group": "navigation@4"
        },
        {
          "command": "pa-hub.views.notes-explorer.clear-filter",
          "when": "view == pa-hub.notes-explorer && pa-hub.views.notes-explorer.filter-active",
          "group": "navigation@5"
        },
        {
          "command": "pa-hub.views.notes-explorer.collapse-all",
          "when": "view == pa-hub.notes-explorer && pa-hub.views.notes-explorer.view-mode != 'flat'",
          "group": "navigation@6"
        },
        {
          "command": "pa-hub.views.smart-folders.create",
          "when": "view == pa-hub.smart-folders",
          "group": "navigation@1"
        },
        {
          "command": "pa-hub.views.smart-folders.group-by:folder",
          "when": "view == pa-hub.smart-folders && pa-hub.views.smart-folders.group-by == 'off'",
          "group": "navigation@2"
        },
        {
          "command": "pa-hub.views.smart-folders.group-by:off",
          "when": "view == pa-hub.smart-folders && pa-hub.views.smart-folders.group-by == 'folder'",
          "group": "navigation@2"
        },
        {
          "command": "pa-hub.views.smart-folders.refresh",
          "when": "view == pa-hub.smart-folders",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "pa-hub.export-html-page",
          "when": "config.pa-hub.experimental"
        },
        {
          "command": "pa-hub.show-similar-notes",
          "when": "config.pa-hub.experimental"
        },
        {
          "command": "pa-hub.build-embeddings",
          "when": "config.pa-hub.experimental"
        },
        {
          "command": "pa-hub.create-note-from-default-template",
          "when": "false"
        },
        {
          "command": "pa-hub.update-graph",
          "when": "false"
        },
        {
          "command": "pa-hub.views.connections.show:all-links",
          "when": "false"
        },
        {
          "command": "pa-hub.views.connections.show:backlinks",
          "when": "false"
        },
        {
          "command": "pa-hub.views.connections.show:forward-links",
          "when": "false"
        },
        {
          "command": "pa-hub.views.connections.include:notes-only",
          "when": "false"
        },
        {
          "command": "pa-hub.views.connections.include:all",
          "when": "false"
        },
        {
          "command": "pa-hub.views.notes-explorer.include:notes-only",
          "when": "false"
        },
        {
          "command": "pa-hub.views.notes-explorer.include:all",
          "when": "false"
        },
        {
          "command": "pa-hub.views.orphans.group-by:folder",
          "when": "false"
        },
        {
          "command": "pa-hub.views.orphans.group-by:off",
          "when": "false"
        },
        {
          "command": "pa-hub.views.tags-explorer.show:for-current-file",
          "when": "false"
        },
        {
          "command": "pa-hub.views.tags-explorer.show:all",
          "when": "false"
        },
        {
          "command": "pa-hub.views.tags-explorer.group-by:folder",
          "when": "false"
        },
        {
          "command": "pa-hub.views.tags-explorer.group-by:off",
          "when": "false"
        },
        {
          "command": "pa-hub.views.tags-explorer.expand-all",
          "when": "false"
        },
        {
          "command": "pa-hub.views.placeholders.show:for-current-file",
          "when": "false"
        },
        {
          "command": "pa-hub.views.placeholders.show:all",
          "when": "false"
        },
        {
          "command": "pa-hub.views.placeholders.group-by:folder",
          "when": "false"
        },
        {
          "command": "pa-hub.views.placeholders.group-by:off",
          "when": "false"
        },
        {
          "command": "pa-hub.views.placeholders.expand-all",
          "when": "false"
        },
        {
          "command": "pa-hub.open-resource",
          "when": "false"
        },
        {
          "command": "pa-hub.completion-move-cursor",
          "when": "false"
        },
        {
          "command": "pa-hub.views.smart-folders.group-by:folder",
          "when": "false"
        },
        {
          "command": "pa-hub.views.smart-folders.group-by:off",
          "when": "false"
        },
        {
          "command": "pa-hub.views.smart-folders.refresh",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "pa-hub.show-whats-new",
        "title": "Foam: Show What's New",
        "category": "PA Hub"
      },
      {
        "command": "pa-hub.create-note",
